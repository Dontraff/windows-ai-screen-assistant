<Window x:Class="ScreenAssistant.Overlay.CropSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выбор области" WindowStyle="None" AllowsTransparency="True"
        Background="#33000000" Topmost="True" ShowInTaskbar="False"
        ResizeMode="NoResize" WindowStartupLocation="Manual"
        Cursor="Cross" KeyDown="Window_KeyDown">
    <Canvas x:Name="Surface" Background="Transparent"
            MouseLeftButtonDown="Surface_MouseLeftButtonDown"
            MouseMove="Surface_MouseMove"
            MouseLeftButtonUp="Surface_MouseLeftButtonUp">
        <Border x:Name="Selection" BorderBrush="#4DA3FF" BorderThickness="1"
                Background="#224DA3FF" Visibility="Collapsed"/>
    </Canvas>
</Window>
